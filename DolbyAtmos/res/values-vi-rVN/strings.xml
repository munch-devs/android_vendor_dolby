    <string name="dolby_hdmi_connected_title">Đã kết nối HDMI</string>
    <string name="dolby_hdmi_connected_desc">Âm thanh hiện đang được xuất ra thiết bị HDMI bên ngoài. Cài đặt Dolby Atmos do màn hình hoặc hệ thống âm thanh bên ngoài của bạn quản lý.</string>
