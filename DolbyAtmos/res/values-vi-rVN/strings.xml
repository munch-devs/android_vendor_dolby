    <!-- Help & Explore Dialogs -->
    <string name="dolby_help_title">Trợ giúp về tính năng của cấu hình</string>
    <string name="dolby_help_ieq_desc">Bộ cân bằng âm thông minh tự động điều chỉnh cân bằng tần số của âm thanh để phù hợp với tông âm bạn chọn (Chi tiết, Cân bằng hoặc Ấm).</string>
    <string name="dolby_help_stereo_widening_desc">Điều khiển độ rộng của không gian âm thanh nổi khi nghe bằng tai nghe.</string>
    <string name="dolby_help_reverb_reduction_desc">Loại bỏ tiếng vang và độ vọng của phòng để giọng hát và nhạc cụ nghe rõ ràng hơn.</string>
    <string name="dolby_help_dialogue_enhancer_desc">Tăng cường các tần số giọng nói để dễ nghe hội thoại trong phim, podcast và video hơn.</string>
    <string name="dolby_help_geq_desc">Tinh chỉnh thủ công từng dải tần số hoặc chọn một chế độ cài đặt sẵn theo thể loại để tạo âm thanh theo ý bạn.</string>
    <string name="dolby_explore_title">Khám phá Dolby Atmos</string>
    <string name="dolby_explore_desc">Dolby Atmos di chuyển âm thanh xung quanh bạn trong không gian ba chiều, mang nội dung giải trí đến gần bạn một cách sống động.</string>
    <string name="dolby_learn_more_web">Tìm hiểu thêm tại dolby.com</string>
    <string name="dolby_access_apps">Truy cập các ứng dụng được tối ưu bởi Dolby</string>

